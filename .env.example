# ==============================================
# Student Financial Wellness Platform
# Environment Configuration Example
# Copy this file to ".env" and fill in your values
# ==============================================

# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=change_this_to_a_long_random_secret_string

# MySQL Database (works with any MySQL-compatible host, e.g. local
# XAMPP/MySQL or a managed cloud provider like TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=student_financial_wellness
# Set to true for managed/cloud providers that require TLS (e.g. TiDB Cloud)
DB_SSL=false
