<%- include('partials/budgetTabs', { activeTab: 'daily' }) %>

<div class="glass-card mb-4" id="a2hsBanner" style="display:none;">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div class="d-flex align-items-center gap-3">
      <div class="stat-icon icon-budget" style="margin-bottom:0;"><i class="fa-solid fa-mobile-screen-button"></i></div>
      <div>
        <div class="fw-semibold" style="font-family:'Sora', sans-serif;">Add Daily Budget to your Home Screen</div>
        <div id="a2hsText" style="color:var(--muted); font-size:0.85rem;">Get one-tap access, styled like an app.</div>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button type="button" id="a2hsInstallBtn" class="btn btn-brand btn-sm" style="display:none;">
        <i class="fa-solid fa-download me-1"></i> Install
      </button>
      <button type="button" id="a2hsDismissBtn" class="action-icon-btn" title="Dismiss">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </div>
</div>

<div class="glass-card mb-4">
  <div class="section-title mb-0"><i class="fa-solid fa-calendar-days"></i> Daily Budget Planner</div>
  <p style="color:var(--muted); font-size:0.85rem; margin-top:6px; margin-bottom:0;">
    Set a daily spending amount, log what you actually spend each day, and any over- or under-spending
    automatically carries into your running balance — spend too much today, and you'll need to rein it in
    tomorrow to stay on track.
  </p>
</div>

<% if (!dailyPlan) { %>
  <div class="glass-card">
    <div class="empty-state">
      <i class="fa-solid fa-calendar-day"></i>
      <p>No daily budget set up yet. Pick an amount to spend per day — on food, fare, and other everyday costs — and start tracking.</p>
      <form action="/budget/daily" method="POST" class="mt-2" style="max-width:320px; margin:0 auto;">
        <div class="input-group">
          <span class="input-group-text">৳</span>
          <input type="number" step="0.01" min="0.01" name="dailyAmount" class="form-control" placeholder="e.g. 200" required />
          <button type="submit" class="btn btn-brand"><i class="fa-solid fa-play me-1"></i> Start</button>
        </div>
      </form>
    </div>
  </div>
<% } else { %>

  <!-- Running Balance hero -->
  <div class="glass-card mb-4" style="text-align:center; padding:32px 20px;">
    <div class="stat-label" style="justify-content:center;">Running Balance</div>
    <div class="stat-value" style="font-size:2.4rem; color: <%= dailyPlan.runningBalance < 0 ? 'var(--danger)' : 'var(--primary)' %>;">
      ৳<%= dailyPlan.runningBalance.toFixed(2) %>
    </div>
    <p style="color:var(--muted); font-size:0.85rem; margin-bottom:0;">
      <% if (dailyPlan.runningBalance < 0) { %>
        You're ৳<%= Math.abs(dailyPlan.runningBalance).toFixed(2) %> over budget since <%= dailyPlan.startDate %> — spend less than usual today to catch up.
      <% } else { %>
        You're ৳<%= dailyPlan.runningBalance.toFixed(2) %> ahead of budget since <%= dailyPlan.startDate %>. Keep it up!
      <% } %>
    </p>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="glass-card stat-card h-100">
        <div class="stat-icon icon-budget"><i class="fa-solid fa-calendar-day"></i></div>
        <div class="stat-label">Daily Budget</div>
        <div class="stat-value">৳<%= dailyPlan.dailyAmount.toFixed(2) %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="glass-card stat-card h-100">
        <div class="stat-icon icon-expense"><i class="fa-solid fa-utensils"></i></div>
        <div class="stat-label">Spent Today</div>
        <div class="stat-value">৳<%= dailyPlan.todayEntry ? dailyPlan.todayEntry.spent.toFixed(2) : '0.00' %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="glass-card stat-card h-100">
        <div class="stat-icon icon-income"><i class="fa-solid fa-calendar-week"></i></div>
        <div class="stat-label">Days Tracked</div>
        <div class="stat-value"><%= dailyPlan.daysTracked %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="glass-card stat-card h-100">
        <div class="stat-icon icon-savings"><i class="fa-solid fa-chart-line"></i></div>
        <div class="stat-label">Avg. Daily Spend</div>
        <div class="stat-value">৳<%= dailyPlan.averageDailySpend.toFixed(2) %></div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <!-- Log today's spending + settings -->
    <div class="col-lg-5">
      <div class="glass-card h-100">
        <div class="section-title"><i class="fa-solid fa-plus"></i> Log Today's Spending</div>
        <p style="color:var(--muted); font-size:0.85rem; margin-top:-10px;">
          Use the manual expense entry on the Expenses page to log what you spend — it feeds straight into this
          breakdown and your running balance.
        </p>
        <a href="/expenses" class="btn btn-brand w-100 mb-2"><i class="fa-solid fa-arrow-right me-1"></i> Go to Add Expense</a>

        <a href="/budget/daily/report/weekly" class="btn btn-outline-brand w-100 mb-4"><i class="fa-solid fa-file-arrow-down me-1"></i> Download Weekly Report (CSV)</a>

        <hr style="border-color:var(--glass-border);">

        <div class="section-title" style="font-size:0.95rem;"><i class="fa-solid fa-sliders"></i> Change Daily Budget</div>
        <form action="/budget/daily" method="POST" class="mb-2">
          <div class="mb-2">
            <input type="number" step="0.01" min="0.01" name="dailyAmount" class="form-control"
              value="<%= dailyPlan.dailyAmount.toFixed(2) %>" required />
          </div>
          <button type="submit" class="btn btn-outline-brand w-100 btn-sm"><i class="fa-solid fa-floppy-disk me-1"></i> Save (starts a fresh period today)</button>
        </form>
        <form action="/budget/daily/reset" method="POST" class="confirm-delete" data-label="your daily budget plan — this clears your running balance and history">
          <button type="submit" class="btn btn-link w-100 btn-sm text-danger"><i class="fa-solid fa-rotate-left me-1"></i> Reset Plan</button>
        </form>
      </div>
    </div>

    <!-- Daily breakdown log -->
    <div class="col-lg-7">
      <div class="glass-card h-100">
        <div class="section-title"><i class="fa-solid fa-table-list"></i> Daily Breakdown</div>

        <% if (dailyPlan.todayEntry) { %>
          <% const todayPct = dailyPlan.dailyAmount > 0 ? Math.min(100, (dailyPlan.todayEntry.spent / dailyPlan.dailyAmount) * 100) : 0; %>
          <div class="d-flex justify-content-between mb-2" style="font-size:0.9rem; color:var(--muted);">
            <span>Today's Spending vs. Daily Budget</span>
            <span><%= todayPct.toFixed(1) %>% used</span>
          </div>
          <div class="progress-modern mb-4">
            <div class="progress-bar-fill <%= dailyPlan.todayEntry.overBudget ? 'over-limit' : '' %>" style="width: <%= todayPct %>%;"></div>
          </div>
        <% } %>

        <div class="table-responsive" style="max-height:400px; overflow-y:auto;">
          <table class="table table-modern mb-0">
            <thead><tr><th>Date</th><th class="text-end">Budget</th><th class="text-end">Spent</th><th class="text-end">Difference</th><th class="text-end">Balance</th></tr></thead>
            <tbody>
              <% dailyPlan.days.forEach(d => { %>
                <tr style="<%= d.isToday ? 'background:var(--mint-soft);' : '' %>">
                  <td class="fw-semibold"><%= d.date %><% if (d.isToday) { %> <span class="chip-filter" style="padding:2px 10px; font-size:0.7rem;">Today</span><% } %></td>
                  <td class="text-end amount">৳<%= dailyPlan.dailyAmount.toFixed(2) %></td>
                  <td class="text-end amount"><%= d.spent > 0 ? '৳' + d.spent.toFixed(2) : '—' %></td>
                  <td class="text-end amount" style="color: <%= d.difference < 0 ? 'var(--danger)' : 'var(--primary)' %>;">
                    <%= d.difference >= 0 ? '+' : '' %>৳<%= d.difference.toFixed(2) %>
                  </td>
                  <td class="text-end amount fw-semibold" style="color: <%= d.runningBalance < 0 ? 'var(--danger)' : 'inherit' %>;">৳<%= d.runningBalance.toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% } %>

<!-- Fixed Daily Expenses (recurring: Food, Travel Fare, etc.) -->
<div class="glass-card mt-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-1">
    <div class="section-title mb-0"><i class="fa-solid fa-repeat"></i> Fixed Daily Expenses</div>
    <div class="d-flex gap-2">
      <% if (fixedExpenses.some(f => !f.loggedToday)) { %>
        <form action="/budget/daily/fixed/log-all" method="POST">
          <button type="submit" class="btn btn-outline-brand btn-sm"><i class="fa-solid fa-check-double me-1"></i> Log All for Today</button>
        </form>
      <% } %>
      <button class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#addFixedExpenseModal">
        <i class="fa-solid fa-plus me-1"></i> Add Fixed Expense
      </button>
    </div>
  </div>
  <p style="color:var(--muted); font-size:0.85rem;">
    Recurring day-to-day costs — food, travel fare, and anything else you spend on every day. Log them with one click instead of filling out the full expense form each time.
  </p>

  <% if (fixedExpenses.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-repeat"></i>
      <p>No fixed daily expenses set up yet. Add things like "Lunch" (Food) or "Bus Fare" (Transport) to log them in one click each day.</p>
    </div>
  <% } else { %>
    <div class="row g-3 mb-3">
      <div class="col-6 col-md-4">
        <div class="stat-label">Total Fixed Daily Cost</div>
        <div class="stat-value" style="font-size:1.1rem;">৳<%= fixedDailyTotal.toFixed(2) %></div>
      </div>
      <% if (flexibleDailyBudget !== null) { %>
        <div class="col-6 col-md-4">
          <div class="stat-label">Flexible Budget Left Today</div>
          <div class="stat-value" style="font-size:1.1rem; color: <%= flexibleDailyBudget < 0 ? 'var(--danger)' : 'inherit' %>;">
            ৳<%= flexibleDailyBudget.toFixed(2) %>
          </div>
        </div>
      <% } %>
    </div>

    <div class="table-responsive">
      <table class="table table-modern mb-0">
        <thead><tr><th>Item</th><th>Category</th><th class="text-end">Amount</th><th class="text-end">Today</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
          <% fixedExpenses.forEach(f => { %>
            <tr>
              <td class="fw-semibold"><%= f.label %></td>
              <td><span class="badge-category badge-<%= f.category.toLowerCase() %>"><%= f.category %></span></td>
              <td class="text-end amount">৳<%= f.amount.toFixed(2) %></td>
              <td class="text-end">
                <% if (f.loggedToday) { %>
                  <span class="badge-category" style="background:rgba(15,122,77,0.12); color:var(--primary);"><i class="fa-solid fa-check me-1"></i>Logged</span>
                <% } else { %>
                  <form action="/budget/daily/fixed/<%= f.id %>/log" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-brand btn-sm"><i class="fa-solid fa-plus me-1"></i>Log Today</button>
                  </form>
                <% } %>
              </td>
              <td class="text-end">
                <button class="action-icon-btn me-1" data-bs-toggle="modal" data-bs-target="#editFixedExpenseModal<%= f.id %>" title="Edit">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <form action="/budget/daily/fixed/<%= f.id %>/delete" method="POST" class="d-inline confirm-delete" data-label="this fixed expense">
                  <button type="submit" class="action-icon-btn danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                </form>
              </td>
            </tr>

            <!-- Edit Modal -->
            <div class="modal fade" id="editFixedExpenseModal<%= f.id %>" tabindex="-1">
              <div class="modal-dialog">
                <div class="modal-content p-2">
                  <form action="/budget/daily/fixed/<%= f.id %>/update" method="POST">
                    <div class="modal-header border-0">
                      <h5 class="modal-title">Edit Fixed Expense</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                      <div class="mb-3">
                        <label class="form-label">Label</label>
                        <input type="text" name="label" class="form-control" value="<%= f.label %>" required />
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="category" class="form-select" required>
                          <% categories.forEach(cat => { %>
                            <option value="<%= cat %>" <%= f.category === cat ? 'selected' : '' %>><%= cat %></option>
                          <% }) %>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Amount (৳)</label>
                        <input type="number" step="0.01" min="0.01" name="amount" class="form-control" value="<%= f.amount.toFixed(2) %>" required />
                      </div>
                    </div>
                    <div class="modal-footer border-0">
                      <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-brand">Save Changes</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Add Fixed Expense Modal -->
<div class="modal fade" id="addFixedExpenseModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content p-2">
      <form action="/budget/daily/fixed" method="POST">
        <div class="modal-header border-0">
          <h5 class="modal-title">Add Fixed Daily Expense</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Label</label>
            <input type="text" name="label" class="form-control" placeholder="e.g. Lunch, Bus Fare, Tea" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="category" class="form-select" required>
              <option value="" disabled selected>Select a category</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Amount (৳)</label>
            <input type="number" step="0.01" min="0.01" name="amount" class="form-control" placeholder="0.00" required />
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i> Add</button>
        </div>
      </form>
    </div>
  </div>
</div>
