<%- include('partials/budgetTabs', { monthYear, activeTab: 'daily' }) %>

<div class="glass-card mb-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="section-title mb-0"><i class="fa-solid fa-calendar-days"></i> Daily Budget Planner — <%= monthYear %></div>
    <form method="GET" action="/budget/daily" class="d-flex gap-2">
      <input type="month" name="month" value="<%= monthYear %>" class="form-control" />
      <button type="submit" class="btn btn-outline-brand"><i class="fa-solid fa-arrows-rotate me-1"></i> View</button>
    </form>
  </div>
</div>

<% if (monthlyBudget === 0) { %>
  <div class="glass-card">
    <div class="empty-state">
      <i class="fa-solid fa-calendar-days"></i>
      <p>No monthly budget set for <%= monthYear %> yet. Set one on the Budget Planner page first — the Daily Budget Planner uses it to work out your everyday spending allowance.</p>
      <a href="/budget?month=<%= monthYear %>" class="btn btn-brand mt-2"><i class="fa-solid fa-piggy-bank me-1"></i> Set Monthly Budget</a>
    </div>
  </div>
<% } else { %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="glass-card stat-card h-100">
        <div class="stat-icon icon-budget"><i class="fa-solid fa-calendar-day"></i></div>
        <div class="stat-label"><%= dailyPlan.isCustomDailyBudget ? 'Custom' : 'Auto-Calculated' %> Daily Budget</div>
        <div class="stat-value">৳<%= dailyPlan.dailyBudget.toFixed(2) %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="glass-card stat-card h-100">
        <div class="stat-icon icon-expense"><i class="fa-solid fa-utensils"></i></div>
        <div class="stat-label">Spent Today</div>
        <div class="stat-value">৳<%= dailyPlan.todayEntry ? dailyPlan.todayEntry.spent.toFixed(2) : '0.00' %></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="glass-card stat-card h-100">
        <div class="stat-icon icon-savings"><i class="fa-solid fa-wallet"></i></div>
        <div class="stat-label">Remaining Today</div>
        <div class="stat-value" style="color: <%= dailyPlan.todayEntry && dailyPlan.todayEntry.remaining < 0 ? 'var(--danger)' : 'inherit' %>;">
          ৳<%= dailyPlan.todayEntry ? dailyPlan.todayEntry.remaining.toFixed(2) : dailyPlan.dailyBudget.toFixed(2) %>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="glass-card stat-card h-100">
        <div class="stat-icon icon-income"><i class="fa-solid fa-calendar-week"></i></div>
        <div class="stat-label">Days in Month</div>
        <div class="stat-value"><%= dailyPlan.totalDays %></div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <!-- Set / customize daily budget -->
    <div class="col-lg-5">
      <div class="glass-card h-100">
        <div class="section-title"><i class="fa-solid fa-sliders"></i> Set Daily Spending Limit</div>
        <p style="color:var(--muted); font-size:0.85rem; margin-top:-10px;">
          Set aside a fixed amount for everyday spending — food, fare/transport, and other daily costs —
          separate from your overall monthly budget. Leave it unset and we'll split your monthly budget evenly across the month.
        </p>

        <form action="/budget/daily" method="POST" class="mb-2">
          <input type="hidden" name="monthYear" value="<%= monthYear %>" />
          <div class="mb-3">
            <label class="form-label">Daily Spending Limit (৳)</label>
            <input type="number" step="0.01" min="0.01" name="dailyBudget" class="form-control"
              value="<%= dailyPlan.isCustomDailyBudget ? dailyPlan.dailyBudget.toFixed(2) : '' %>"
              placeholder="Auto: ৳<%= dailyPlan.dailyBudget.toFixed(2) %> (monthly budget ÷ <%= dailyPlan.totalDays %> days)" required />
          </div>
          <button type="submit" class="btn btn-brand w-100"><i class="fa-solid fa-floppy-disk me-1"></i> Save Daily Budget</button>
        </form>
        <% if (dailyPlan.isCustomDailyBudget) { %>
          <form action="/budget/daily/reset" method="POST">
            <input type="hidden" name="monthYear" value="<%= monthYear %>" />
            <button type="submit" class="btn btn-outline-brand w-100 btn-sm"><i class="fa-solid fa-rotate-left me-1"></i> Reset to Auto-Calculated</button>
          </form>
        <% } %>

        <% if (dailyPlan.isCurrentMonth) { %>
          <hr class="my-4" style="border-color:var(--glass-border);">
          <div class="d-flex justify-content-between mb-2" style="font-size:0.9rem;">
            <span style="color:var(--muted);">Adjusted Budget for Remaining <%= dailyPlan.daysRemainingInclToday %> Day(s)</span>
            <span class="fw-semibold" style="color: <%= dailyPlan.adjustedDailyBudgetForRest < 0 ? 'var(--danger)' : 'inherit' %>;">
              ৳<%= dailyPlan.adjustedDailyBudgetForRest.toFixed(2) %> / day
            </span>
          </div>
          <div class="d-flex justify-content-between" style="font-size:0.9rem;">
            <span style="color:var(--muted);">Projected Leftover at Month End</span>
            <span class="fw-semibold" style="color: <%= dailyPlan.projectedEndOfMonthBalance < 0 ? 'var(--danger)' : 'var(--primary)' %>;">
              ৳<%= dailyPlan.projectedEndOfMonthBalance.toFixed(2) %>
            </span>
          </div>
          <p style="color:var(--muted); font-size:0.78rem; margin-top:6px; margin-bottom:0;">
            If you keep spending ৳<%= dailyPlan.dailyBudget.toFixed(2) %>/day for the rest of <%= monthYear %>,
            this is how much you'll have kept aside for daily expenses by month end.
          </p>
        <% } %>
      </div>
    </div>

    <!-- Today's progress + day-by-day breakdown -->
    <div class="col-lg-7">
      <div class="glass-card h-100">
        <div class="section-title"><i class="fa-solid fa-table-list"></i> Daily Breakdown</div>

        <% if (dailyPlan.todayEntry) { %>
          <% const todayPct = dailyPlan.dailyBudget > 0 ? Math.min(100, (dailyPlan.todayEntry.spent / dailyPlan.dailyBudget) * 100) : 0; %>
          <div class="d-flex justify-content-between mb-2" style="font-size:0.9rem; color:var(--muted);">
            <span>Today's Spending vs. Daily Allowance</span>
            <span><%= todayPct.toFixed(1) %>% used</span>
          </div>
          <div class="progress-modern mb-4">
            <div class="progress-bar-fill <%= dailyPlan.todayEntry.overBudget ? 'over-limit' : '' %>" style="width: <%= todayPct %>%;"></div>
          </div>
        <% } %>

        <div class="table-responsive" style="max-height:400px; overflow-y:auto;">
          <table class="table table-modern mb-0">
            <thead><tr><th>Date</th><th class="text-end">Daily Allowance</th><th class="text-end">Spent</th><th class="text-end">Remaining</th><th class="text-end">Status</th></tr></thead>
            <tbody>
              <% dailyPlan.days.forEach(d => { %>
                <tr style="<%= d.isToday ? 'background:var(--mint-soft);' : '' %>">
                  <td class="fw-semibold"><%= d.date %><% if (d.isToday) { %> <span class="chip-filter" style="padding:2px 10px; font-size:0.7rem;">Today</span><% } %></td>
                  <td class="text-end amount">৳<%= dailyPlan.dailyBudget.toFixed(2) %></td>
                  <td class="text-end amount"><%= d.spent > 0 ? '৳' + d.spent.toFixed(2) : '—' %></td>
                  <td class="text-end amount" style="color: <%= d.remaining < 0 ? 'var(--danger)' : 'inherit' %>;">৳<%= d.remaining.toFixed(2) %></td>
                  <td class="text-end">
                    <% if (d.isFuture) { %>
                      <span class="badge-category">Upcoming</span>
                    <% } else if (d.overBudget) { %>
                      <span class="badge-category" style="background:rgba(229,72,77,0.14); color:var(--danger);">Over Budget</span>
                    <% } else { %>
                      <span class="badge-category" style="background:rgba(15,122,77,0.12); color:var(--primary);">Within Budget</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% } %>

<!-- Fixed Daily Expenses (recurring: Food, Travel Fare, etc.) -->
<div class="glass-card mt-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-1">
    <div class="section-title mb-0"><i class="fa-solid fa-repeat"></i> Fixed Daily Expenses</div>
    <div class="d-flex gap-2">
      <% if (fixedExpenses.some(f => !f.loggedToday)) { %>
        <form action="/budget/daily/fixed/log-all" method="POST">
          <button type="submit" class="btn btn-outline-brand btn-sm"><i class="fa-solid fa-check-double me-1"></i> Log All for Today</button>
        </form>
      <% } %>
      <button class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#addFixedExpenseModal">
        <i class="fa-solid fa-plus me-1"></i> Add Fixed Expense
      </button>
    </div>
  </div>
  <p style="color:var(--muted); font-size:0.85rem;">
    Recurring day-to-day costs — food, travel fare, and anything else you spend on every day. Log them with one click instead of filling out the full expense form each time.
  </p>

  <% if (fixedExpenses.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-repeat"></i>
      <p>No fixed daily expenses set up yet. Add things like "Lunch" (Food) or "Bus Fare" (Transport) to log them in one click each day.</p>
    </div>
  <% } else { %>
    <div class="row g-3 mb-3">
      <div class="col-6 col-md-4">
        <div class="stat-label">Total Fixed Daily Cost</div>
        <div class="stat-value" style="font-size:1.1rem;">৳<%= fixedDailyTotal.toFixed(2) %></div>
      </div>
      <% if (monthlyBudget > 0) { %>
        <div class="col-6 col-md-4">
          <div class="stat-label">Flexible Budget Left Today</div>
          <div class="stat-value" style="font-size:1.1rem; color: <%= flexibleDailyBudget < 0 ? 'var(--danger)' : 'inherit' %>;">
            ৳<%= flexibleDailyBudget.toFixed(2) %>
          </div>
        </div>
      <% } %>
    </div>

    <div class="table-responsive">
      <table class="table table-modern mb-0">
        <thead><tr><th>Item</th><th>Category</th><th class="text-end">Amount</th><th class="text-end">Today</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
          <% fixedExpenses.forEach(f => { %>
            <tr>
              <td class="fw-semibold"><%= f.label %></td>
              <td><span class="badge-category badge-<%= f.category.toLowerCase() %>"><%= f.category %></span></td>
              <td class="text-end amount">৳<%= f.amount.toFixed(2) %></td>
              <td class="text-end">
                <% if (f.loggedToday) { %>
                  <span class="badge-category" style="background:rgba(15,122,77,0.12); color:var(--primary);"><i class="fa-solid fa-check me-1"></i>Logged</span>
                <% } else { %>
                  <form action="/budget/daily/fixed/<%= f.id %>/log" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-brand btn-sm"><i class="fa-solid fa-plus me-1"></i>Log Today</button>
                  </form>
                <% } %>
              </td>
              <td class="text-end">
                <button class="action-icon-btn me-1" data-bs-toggle="modal" data-bs-target="#editFixedExpenseModal<%= f.id %>" title="Edit">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <form action="/budget/daily/fixed/<%= f.id %>/delete" method="POST" class="d-inline confirm-delete" data-label="this fixed expense">
                  <button type="submit" class="action-icon-btn danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                </form>
              </td>
            </tr>

            <!-- Edit Modal -->
            <div class="modal fade" id="editFixedExpenseModal<%= f.id %>" tabindex="-1">
              <div class="modal-dialog">
                <div class="modal-content p-2">
                  <form action="/budget/daily/fixed/<%= f.id %>/update" method="POST">
                    <div class="modal-header border-0">
                      <h5 class="modal-title">Edit Fixed Expense</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                      <div class="mb-3">
                        <label class="form-label">Label</label>
                        <input type="text" name="label" class="form-control" value="<%= f.label %>" required />
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="category" class="form-select" required>
                          <% categories.forEach(cat => { %>
                            <option value="<%= cat %>" <%= f.category === cat ? 'selected' : '' %>><%= cat %></option>
                          <% }) %>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Amount (৳)</label>
                        <input type="number" step="0.01" min="0.01" name="amount" class="form-control" value="<%= f.amount.toFixed(2) %>" required />
                      </div>
                    </div>
                    <div class="modal-footer border-0">
                      <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-brand">Save Changes</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Add Fixed Expense Modal -->
<div class="modal fade" id="addFixedExpenseModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content p-2">
      <form action="/budget/daily/fixed" method="POST">
        <div class="modal-header border-0">
          <h5 class="modal-title">Add Fixed Daily Expense</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Label</label>
            <input type="text" name="label" class="form-control" placeholder="e.g. Lunch, Bus Fare, Tea" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="category" class="form-select" required>
              <option value="" disabled selected>Select a category</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Amount (৳)</label>
            <input type="number" step="0.01" min="0.01" name="amount" class="form-control" placeholder="0.00" required />
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i> Add</button>
        </div>
      </form>
    </div>
  </div>
</div>
