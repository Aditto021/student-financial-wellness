<div class="glass-card mb-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-2">
    <div class="section-title mb-0"><i class="fa-solid fa-bolt"></i> Quick Add — Small Daily Expenses</div>
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <div style="color:var(--muted); font-size:0.85rem;">Spent today: <span class="fw-bold" style="color:var(--danger);">৳<%= todayTotal.toFixed(2) %></span></div>
      <button class="btn btn-outline-brand btn-sm" data-bs-toggle="modal" data-bs-target="#managePresetsModal">
        <i class="fa-solid fa-sliders me-1"></i> Manage
      </button>
    </div>
  </div>
  <p style="color:var(--muted); font-size:0.85rem; margin-top:-4px;">
    Tap an item below to log it instantly — for the little everyday spends (coke, biscuit, fare) that are easy to forget.
  </p>

  <% if (presets.length === 0) { %>
    <div class="empty-state" style="padding:24px 20px;">
      <i class="fa-solid fa-bolt"></i>
      <p>No quick-add items yet. Click "Manage" to add things like Coke, Biscuit, or Bus Fare.</p>
    </div>
  <% } else { %>
    <div class="d-flex flex-wrap gap-2">
      <% presets.forEach(p => { %>
        <form action="/expenses/quick-add/<%= p.preset_id %>" method="POST">
          <button type="submit" class="quick-add-chip">
            <span class="quick-add-icon"><%= p.icon || '🧾' %></span>
            <span class="quick-add-label"><%= p.label %></span>
            <span class="quick-add-amount">৳<%= parseFloat(p.amount).toFixed(2) %></span>
          </button>
        </form>
      <% }) %>
    </div>
  <% } %>
</div>

<div class="glass-card mb-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
    <div class="section-title mb-0"><i class="fa-solid fa-cart-shopping"></i> Expense Records</div>
    <button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
      <i class="fa-solid fa-plus me-1"></i> Add Expense
    </button>
  </div>

  <!-- Search / filter -->
  <form method="GET" action="/expenses" class="row g-2 mb-3">
    <div class="col-md-3">
      <input type="text" name="search" class="form-control" placeholder="Search description..." value="<%= filters.search %>" />
    </div>
    <div class="col-md-2">
      <select name="category" class="form-select">
        <option value="">All Categories</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-3">
      <input type="date" name="startDate" class="form-control" value="<%= filters.startDate %>" />
    </div>
    <div class="col-md-2">
      <input type="date" name="endDate" class="form-control" value="<%= filters.endDate %>" />
    </div>
    <div class="col-md-2">
      <button class="btn btn-outline-brand w-100" type="submit"><i class="fa-solid fa-filter me-1"></i>Filter</button>
    </div>
  </form>

  <div class="mb-3" style="color:var(--muted);">
    Showing <%= expenses.length %> record(s) · Total: <span class="fw-bold text-danger">৳<%= total.toFixed(2) %></span>
  </div>

  <% if (expenses.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-receipt"></i>
      <p>No expense records found. Add your first expense to start tracking.</p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-modern mb-0">
        <thead><tr><th>Category</th><th>Amount</th><th>Date</th><th>Description</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
          <% expenses.forEach(exp => { %>
            <tr>
              <td><span class="badge-category badge-<%= exp.category.toLowerCase() %>"><%= exp.category %></span></td>
              <td class="amount">৳<%= parseFloat(exp.amount).toFixed(2) %></td>
              <td><%= exp.expense_date %></td>
              <td style="color:var(--muted);"><%= exp.description || '—' %></td>
              <td class="text-end">
                <button class="action-icon-btn me-1" data-bs-toggle="modal" data-bs-target="#editExpenseModal<%= exp.expense_id %>" title="Edit">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <form action="/expenses/<%= exp.expense_id %>/delete" method="POST" class="d-inline confirm-delete" data-label="this expense record">
                  <button type="submit" class="action-icon-btn danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                </form>
              </td>
            </tr>

            <!-- Edit Modal -->
            <div class="modal fade" id="editExpenseModal<%= exp.expense_id %>" tabindex="-1">
              <div class="modal-dialog">
                <div class="modal-content p-2">
                  <form action="/expenses/<%= exp.expense_id %>/update" method="POST">
                    <div class="modal-header border-0">
                      <h5 class="modal-title">Edit Expense</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                      <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="category" class="form-select" required>
                          <% categories.forEach(cat => { %>
                            <option value="<%= cat %>" <%= exp.category === cat ? 'selected' : '' %>><%= cat %></option>
                          <% }) %>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Amount (৳)</label>
                        <input type="number" step="0.01" min="0.01" name="amount" class="form-control" value="<%= exp.amount %>" required />
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input type="date" name="expenseDate" class="form-control" value="<%= exp.expense_date %>" required />
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Description</label>
                        <input type="text" name="description" class="form-control" value="<%= exp.description || '' %>" />
                      </div>
                    </div>
                    <div class="modal-footer border-0">
                      <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-brand">Save Changes</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Add Expense Modal -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content p-2">
      <form action="/expenses" method="POST">
        <div class="modal-header border-0">
          <h5 class="modal-title">Add Expense</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="category" class="form-select" required>
              <option value="" disabled selected>Select a category</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Amount (৳)</label>
            <input type="number" step="0.01" min="0.01" name="amount" class="form-control" placeholder="0.00" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Date</label>
            <input type="date" name="expenseDate" class="form-control" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Description <span class="text-muted small">(optional)</span></label>
            <input type="text" name="description" class="form-control" placeholder="What was this expense for?" />
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i> Add Expense</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Manage Quick Add Presets Modal -->
<div class="modal fade" id="managePresetsModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content p-2">
      <div class="modal-header border-0">
        <h5 class="modal-title"><i class="fa-solid fa-bolt me-1"></i> Manage Quick Add Items</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form action="/expenses/presets" method="POST" class="row g-2 mb-4">
          <div class="col-md-2">
            <input type="text" name="icon" class="form-control" placeholder="🥤" maxlength="10" />
          </div>
          <div class="col-md-3">
            <input type="text" name="label" class="form-control" placeholder="e.g. Coke" required />
          </div>
          <div class="col-md-3">
            <select name="category" class="form-select" required>
              <option value="" disabled selected>Category</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <input type="number" step="0.01" min="0.01" name="amount" class="form-control" placeholder="৳ Amount" required />
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-brand w-100"><i class="fa-solid fa-plus"></i> Add</button>
          </div>
        </form>

        <% if (presets.length === 0) { %>
          <p style="color:var(--muted);">No quick-add items yet — add one above.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-modern mb-0">
              <thead><tr><th></th><th>Label</th><th>Category</th><th class="text-end">Amount</th><th class="text-end">Actions</th></tr></thead>
              <tbody>
                <% presets.forEach(p => { %>
                  <tr>
                    <td style="font-size:1.2rem;"><%= p.icon || '🧾' %></td>
                    <td class="fw-semibold"><%= p.label %></td>
                    <td><span class="badge-category badge-<%= p.category.toLowerCase() %>"><%= p.category %></span></td>
                    <td class="text-end amount">৳<%= parseFloat(p.amount).toFixed(2) %></td>
                    <td class="text-end">
                      <button type="button" class="action-icon-btn me-1" title="Edit" data-bs-toggle="modal" data-bs-target="#editPresetModal<%= p.preset_id %>">
                        <i class="fa-solid fa-pen"></i>
                      </button>
                      <form action="/expenses/presets/<%= p.preset_id %>/delete" method="POST" class="d-inline confirm-delete" data-label="this quick-add item">
                        <button type="submit" class="action-icon-btn danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                      </form>
                    </td>
                  </tr>

                  <!-- Edit Preset Modal -->
                  <div class="modal fade" id="editPresetModal<%= p.preset_id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content p-2">
                        <form action="/expenses/presets/<%= p.preset_id %>/update" method="POST">
                          <div class="modal-header border-0">
                            <h5 class="modal-title">Edit Quick Add Item</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">
                            <div class="mb-3">
                              <label class="form-label">Icon (emoji, optional)</label>
                              <input type="text" name="icon" class="form-control" value="<%= p.icon || '' %>" maxlength="10" />
                            </div>
                            <div class="mb-3">
                              <label class="form-label">Label</label>
                              <input type="text" name="label" class="form-control" value="<%= p.label %>" required />
                            </div>
                            <div class="mb-3">
                              <label class="form-label">Category</label>
                              <select name="category" class="form-select" required>
                                <% categories.forEach(cat => { %>
                                  <option value="<%= cat %>" <%= p.category === cat ? 'selected' : '' %>><%= cat %></option>
                                <% }) %>
                              </select>
                            </div>
                            <div class="mb-3">
                              <label class="form-label">Amount (৳)</label>
                              <input type="number" step="0.01" min="0.01" name="amount" class="form-control" value="<%= parseFloat(p.amount).toFixed(2) %>" required />
                            </div>
                          </div>
                          <div class="modal-footer border-0">
                            <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-brand">Save Changes</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
