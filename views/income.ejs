<div class="glass-card mb-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
    <div class="section-title mb-0"><i class="fa-solid fa-money-bill-trend-up"></i> Income Records</div>
    <button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#addIncomeModal">
      <i class="fa-solid fa-plus me-1"></i> Add Income
    </button>
  </div>

  <!-- Search / filter -->
  <form method="GET" action="/income" class="row g-2 mb-3">
    <div class="col-md-4">
      <input type="text" name="search" class="form-control" placeholder="Search source or notes..." value="<%= filters.search %>" />
    </div>
    <div class="col-md-3">
      <input type="date" name="startDate" class="form-control" value="<%= filters.startDate %>" />
    </div>
    <div class="col-md-3">
      <input type="date" name="endDate" class="form-control" value="<%= filters.endDate %>" />
    </div>
    <div class="col-md-2">
      <button class="btn btn-outline-brand w-100" type="submit"><i class="fa-solid fa-filter me-1"></i>Filter</button>
    </div>
  </form>

  <div class="mb-3" style="color:var(--muted);">
    Showing <%= incomes.length %> record(s) · Total: <span class="fw-bold" style="color:var(--primary);">৳<%= total.toFixed(2) %></span>
  </div>

  <% if (incomes.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-money-bill-wave"></i>
      <p>No income records found. Add your first income source to get started.</p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-modern mb-0">
        <thead><tr><th>Source</th><th>Amount</th><th>Date</th><th>Notes</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
          <% incomes.forEach(inc => { %>
            <tr>
              <td class="fw-semibold"><%= inc.source %></td>
              <td class="amount">৳<%= parseFloat(inc.amount).toFixed(2) %></td>
              <td><%= inc.income_date %></td>
              <td style="color:var(--muted);"><%= inc.notes || '—' %></td>
              <td class="text-end">
                <button class="action-icon-btn me-1" data-bs-toggle="modal" data-bs-target="#editIncomeModal<%= inc.income_id %>" title="Edit">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <form action="/income/<%= inc.income_id %>/delete" method="POST" class="d-inline confirm-delete" data-label="this income record">
                  <button type="submit" class="action-icon-btn danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                </form>
              </td>
            </tr>

            <!-- Edit Modal -->
            <div class="modal fade" id="editIncomeModal<%= inc.income_id %>" tabindex="-1">
              <div class="modal-dialog">
                <div class="modal-content p-2">
                  <form action="/income/<%= inc.income_id %>/update" method="POST">
                    <div class="modal-header border-0">
                      <h5 class="modal-title">Edit Income</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                      <div class="mb-3">
                        <label class="form-label">Source</label>
                        <input type="text" name="source" class="form-control" value="<%= inc.source %>" required />
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Amount (৳)</label>
                        <input type="number" step="0.01" min="0.01" name="amount" class="form-control" value="<%= inc.amount %>" required />
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input type="date" name="incomeDate" class="form-control" value="<%= inc.income_date %>" required />
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <input type="text" name="notes" class="form-control" value="<%= inc.notes || '' %>" />
                      </div>
                    </div>
                    <div class="modal-footer border-0">
                      <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-brand">Save Changes</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Add Income Modal -->
<div class="modal fade" id="addIncomeModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content p-2">
      <form action="/income" method="POST">
        <div class="modal-header border-0">
          <h5 class="modal-title">Add Income</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Source</label>
            <input type="text" name="source" class="form-control" placeholder="e.g. Part-time Job, Scholarship" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Amount (৳)</label>
            <input type="number" step="0.01" min="0.01" name="amount" class="form-control" placeholder="0.00" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Date</label>
            <input type="date" name="incomeDate" class="form-control" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Notes <span class="text-muted small">(optional)</span></label>
            <input type="text" name="notes" class="form-control" placeholder="Additional details" />
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i> Add Income</button>
        </div>
      </form>
    </div>
  </div>
</div>
