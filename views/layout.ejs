<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof darkMode !== 'undefined' && darkMode ? 'dark' : 'light' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | FinWell' : 'FinWell' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
    <div class="app-shell">
      <div id="sidebarOverlay" class="d-none" style="position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:999;"></div>
      <%- include('partials/sidebar') %>

      <main class="main-content">
        <div class="topbar">
          <div class="d-flex align-items-center gap-3">
            <button id="sidebarToggleBtn" class="sidebar-toggle-btn"><i class="fa-solid fa-bars"></i></button>
            <div>
              <h2><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h2>
              <div class="subtitle">Welcome back, <%= currentUserName.split(' ')[0] %> 👋</div>
            </div>
          </div>
          <div class="topbar-actions">
            <button id="themeToggle" class="theme-toggle" title="Toggle dark mode">
              <i class="fa-solid <%= darkMode ? 'fa-sun' : 'fa-moon' %>"></i>
            </button>
            <a href="/profile" class="text-decoration-none">
              <% if (profilePicture) { %>
                <img src="/uploads/profile/<%= profilePicture %>" class="avatar-circle" alt="Profile" />
              <% } else { %>
                <div class="avatar-circle"><%= currentUserName.charAt(0).toUpperCase() %></div>
              <% } %>
            </a>
          </div>
        </div>

        <% if (successMessages && successMessages.length) { %>
          <% successMessages.forEach(msg => { %>
            <div class="alert alert-success alert-auto-dismiss glass-card border-0 d-flex align-items-center gap-2 mb-3" role="alert">
              <i class="fa-solid fa-circle-check"></i> <%= msg %>
            </div>
          <% }) %>
        <% } %>
        <% if (errorMessages && errorMessages.length) { %>
          <% errorMessages.forEach(msg => { %>
            <div class="alert alert-danger alert-auto-dismiss glass-card border-0 d-flex align-items-center gap-2 mb-3" role="alert">
              <i class="fa-solid fa-triangle-exclamation"></i> <%= msg %>
            </div>
          <% }) %>
        <% } %>

        <%- body %>
      </main>
    </div>
  <% } else { %>
    <%- body %>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script src="/js/main.js"></script>
  <% if (typeof extraScripts !== 'undefined') { %>
    <%- extraScripts %>
  <% } %>
</body>
</html>
