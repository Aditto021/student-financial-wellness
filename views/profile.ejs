<div class="row g-3">
  <div class="col-lg-4">
    <div class="glass-card text-center">
      <div class="avatar-upload-wrap mx-auto mb-3" id="avatarPreview" data-user-initial="<%= profileUser.full_name.charAt(0).toUpperCase() %>" title="Click to change photo">
        <% if (profileUser.profile_picture) { %>
          <img src="<%= profileUser.profile_picture %>" id="avatarImg" alt="Profile" />
        <% } else { %>
          <div class="avatar-initials" id="avatarInitials"><%= profileUser.full_name.charAt(0).toUpperCase() %></div>
        <% } %>
        <div class="avatar-overlay"><i class="fa-solid fa-camera"></i></div>
        <div class="avatar-spinner d-none" id="avatarSpinner"><i class="fa-solid fa-spinner fa-spin"></i></div>
      </div>
      <input type="file" id="profilePictureInput" name="profilePicture" accept="image/png,image/jpeg,image/gif,image/webp" hidden />

      <h5 class="mb-1"><%= profileUser.full_name %></h5>
      <p style="color:var(--muted);" class="mb-2"><%= profileUser.email %></p>

      <div id="avatarError" class="text-danger small mb-2" style="display:none;"></div>

      <p style="color:var(--muted); font-size:0.8rem;" class="mb-2">Click your photo to change it — JPG, PNG, GIF or WEBP, up to 2MB.</p>

      <% if (profileUser.profile_picture) { %>
        <button type="button" id="removePictureBtn" class="btn btn-link btn-sm text-danger p-0"><i class="fa-solid fa-trash me-1"></i>Remove Photo</button>
      <% } %>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="glass-card mb-3">
      <div class="section-title"><i class="fa-solid fa-user-pen"></i> Edit Profile</div>
      <form action="/profile/update" method="POST">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Full Name</label>
            <input type="text" name="fullName" class="form-control" value="<%= profileUser.full_name %>" required />
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" value="<%= profileUser.email %>" disabled />
          </div>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">University</label>
            <input type="text" name="university" class="form-control" value="<%= profileUser.university || '' %>" />
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Student ID</label>
            <input type="text" name="studentId" class="form-control" value="<%= profileUser.student_id || '' %>" />
          </div>
        </div>
        <button type="submit" class="btn btn-brand"><i class="fa-solid fa-floppy-disk me-1"></i> Save Changes</button>
      </form>
    </div>

    <div class="glass-card">
      <div class="section-title"><i class="fa-solid fa-lock"></i> <%= profileUser.password_hash ? 'Change Password' : 'Set a Password' %></div>
      <% if (!profileUser.password_hash) { %>
        <p style="color:var(--muted); font-size:0.85rem; margin-top:-10px;">
          Your account signed up with Google and has no password yet. Set one below to also be able to log in with your email.
        </p>
      <% } %>
      <form action="/profile/change-password" method="POST">
        <% if (profileUser.password_hash) { %>
          <div class="mb-3">
            <label class="form-label">Current Password</label>
            <input type="password" name="currentPassword" class="form-control" required />
          </div>
        <% } %>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">New Password</label>
            <input type="password" name="newPassword" class="form-control" minlength="6" required />
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Confirm New Password</label>
            <input type="password" name="confirmNewPassword" class="form-control" minlength="6" required />
          </div>
        </div>
        <button type="submit" class="btn btn-brand"><i class="fa-solid fa-key me-1"></i> <%= profileUser.password_hash ? 'Update Password' : 'Set Password' %></button>
      </form>
    </div>
  </div>
</div>
